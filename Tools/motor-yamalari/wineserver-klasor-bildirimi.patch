+/* Köprü yaması: inotify olmayan sistemlerde (macOS) klasör değişikliği bildirimi.
+ * Wine klasör izleyicilerini (ReadDirectoryChangesW) yalnız inotify ile besliyor; macOS'ta hiçbir
+ * olay gelmiyordu. Epic Games Launcher kurulum klasörünü ayrı bir süreçle hazırlıyor ve iki süreç
+ * birbirinin yazdığı dosyayı bu bildirimle bekliyor; olay gelmeyince DP-06 hatası veriyordu.
+ * Burada Wine süreçlerinin wineserver üzerinden yaptığı oluşturma, silme, ad değiştirme ve
+ * yazmak için açılmış dosyanın kapanması olaya çevrilir (Wine dışındaki değişiklikler görülmez). */
+#ifndef HAVE_SYS_INOTIFY_H
+int kopru_dir_watched( void )
+{
+    return !list_empty( &change_list );
+}
+
+void kopru_dir_notify( const char *path, unsigned int action, int is_dir, unsigned int cookie )
+{
+    struct { dev_t dev; ino_t ino; size_t len; } parents[32];
+    unsigned int filter, saved_error;
+    char work[PATH_MAX];
+    struct stat st;
+    struct dir *dir;
+    int count = 0, i;
+    size_t len;
+
+    if (!path || list_empty( &change_list )) return;
+    if ((len = strlen( path )) >= sizeof(work) || path[0] != '/') return;
+
+    switch (action)
+    {
+    case FILE_ACTION_ADDED:
+        filter = (is_dir ? FILE_NOTIFY_CHANGE_DIR_NAME : FILE_NOTIFY_CHANGE_FILE_NAME) | FILE_NOTIFY_CHANGE_CREATION;
+        break;
+    case FILE_ACTION_REMOVED:
+    case FILE_ACTION_RENAMED_OLD_NAME:
+    case FILE_ACTION_RENAMED_NEW_NAME:
+        filter = is_dir ? FILE_NOTIFY_CHANGE_DIR_NAME : FILE_NOTIFY_CHANGE_FILE_NAME;
+        break;
+    default:
+        filter = FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_SIZE;
+        break;
+    }
+
+    /* üst klasörler, en yakından köke */
+    memcpy( work, path, len + 1 );
+    while (count < (int)(sizeof(parents) / sizeof(parents[0])))
+    {
+        char *slash = strrchr( work, '/' );
+        if (!slash) break;
+        if (slash == work) slash[1] = 0;
+        else *slash = 0;
+        if (stat( work, &st )) break;
+        parents[count].dev = st.st_dev;
+        parents[count].ino = st.st_ino;
+        parents[count].len = strlen( work );
+        count++;
+        if (!strcmp( work, "/" )) break;
+    }
+
+    saved_error = get_error();  /* get_unix_fd hata yazabilir; isteğin sonucunu bozmasın */
+    LIST_FOR_EACH_ENTRY( dir, &change_list, struct dir, entry )
+    {
+        struct stat dst;
+        int unix_fd;
+
+        if (!(dir->filter & filter)) continue;
+        if ((unix_fd = get_unix_fd( dir->fd )) == -1 || fstat( unix_fd, &dst )) continue;
+        for (i = 0; i < count; i++)
+        {
+            if (parents[i].dev != dst.st_dev || parents[i].ino != dst.st_ino) continue;
+            if (i == 0 || dir->subtree)
+            {
+                const char *relpath = path + parents[i].len + (parents[i].len > 1 ? 1 : 0);
+                if (dir->want_data)
+                {
+                    size_t rel_len = strlen( relpath );
+                    struct change_record *record = malloc( offsetof(struct change_record, event.name[rel_len]) );
+                    if (record)
+                    {
+                        record->cookie = cookie;
+                        record->event.action = action;
+                        memcpy( record->event.name, relpath, rel_len );
+                        record->event.len = rel_len;
+                        list_add_tail( &dir->change_records, &record->entry );
+                    }
+                }
+                fd_async_wake_up( dir->fd, ASYNC_TYPE_WAIT, STATUS_ALERTED );
+            }
+            break;
+        }
+    }
+    set_error( saved_error );
+}
+#else
+int kopru_dir_watched( void ) { return 0; }
+void kopru_dir_notify( const char *path, unsigned int action, int is_dir, unsigned int cookie ) {}
+#endif
+
