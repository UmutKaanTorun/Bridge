+
+/* Köprü yaması: Dock, Windows programının sürecini çalışan dosyanın adıyla gösterir.
+ * Köprü programı açarken adını KOPRU_APP_NAME'e yazar; bağlantı exe adı yerine bu adla
+ * oluşturulur ve programın açtığı alt süreçler (ör. Steam arayüzünü çizen steamwebhelper)
+ * de aynı adı alır. */
+static char *kopru_app_name(void)
+{
+    const char *name = getenv("KOPRU_APP_NAME");
+    if (!name || !*name || strchr(name, '/') || !strcmp(name, ".") || !strcmp(name, "..")) return NULL;
+    return strdup(name);
 }
 
